{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Database=movieapp;Username=YOUR_DB_USERNAME;Password=YOUR_DB_PASSWORD"
  },
  "Omdb": {
    "ApiKey": "YOUR_OMDB_API_KEY",
    "BaseUrl": "http://www.omdbapi.com/"
  },
  "Jwt": {
    "Key": "YOUR_JWT_SECRET_KEY_MIN_32_CHARS",
    "Issuer": "MovieApp",
    "Audience": "MovieApp",
    "ExpiryHours": 24
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Elasticsearch": {
    "Url": "http://localhost:9200"
  },
  "AllowedHosts": "*"
}
